# ========== 应用基础 ==========
APP_HOST=0.0.0.0
APP_PORT=8001
DEBUG=false
LOG_LEVEL=INFO

# ========== 跨域配置 ==========
CORS_ORIGINS=http://localhost:3000

# ========== MySQL（同 docker-compose 配置） ==========
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=00000000
DB_NAME=ling_diary
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ========== Redis（同 docker-compose 配置） ==========
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_POOL_MAX=20

